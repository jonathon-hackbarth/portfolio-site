---
import "../styles/global.css";
import resumeData from "../../public/resume.json";
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/Hero.astro";
import ImpactHighlights from "../components/ImpactHighlights.astro";
import Resume from "../components/Resume.astro";
import CodeSamples from "../components/CodeSamples.astro";
---

<Layout
  title={`${resumeData.basics.name} - Solutions Architect & Technical Lead`}
  description={resumeData.basics.summary}
>
  <div class="min-h-screen flex flex-col">
    <header>
      <NavBar />
    </header>
    <main id="main-content" class="flex-1 w-full">
      <Hero />
      <ImpactHighlights />
      <Resume />
      <CodeSamples />
    </main>
    <footer
      class="py-12 text-center text-sm text-[var(--text-secondary)] bg-[var(--bg-card)] border-t border-[var(--border-card)]"
      role="contentinfo"
    >
      <p class="font-medium">&copy; {new Date().getFullYear()} Jonathon Hackbarth. All rights reserved.</p>
    </footer>
  </div>
</Layout>
