---
const metrics = [
  { value: "M365 Copilot", label: "Pioneer - First Pilot", target: "metric-m365-copilot", icon: "sparkles" },
  { value: "GitHub Copilot", label: "3x Developer Velocity", target: "metric-github-copilot", icon: "rocket" },
  { value: "Azure & M365", label: "Enterprise Architect", target: "metric-azure-architect", icon: "lightning" },
  { value: "Power Platform AI", label: "$15M Savings", target: "metric-power-platform", icon: "chart" },
];
---

<section id="hero" class="hero-section">
  <div class="max-w-4xl">
    <h1 class="hero-name">Jonathon Hackbarth</h1>
    <p class="hero-title">Enterprise Solutions Architect</p>
    <p class="hero-summary">
      Enterprise Solutions Architect with 18+ years of experience in Microsoft 365 and AI innovation. Expert in M365 Copilot, GitHub Copilot, Copilot Studio, and Power Platform, driving AI-enhanced enterprise transformation and advisory services.
    </p>
    
    <!-- Contact Links -->
    <div class="contact-links animate-pop-in">
      <a
        href="mailto:me@jonathonhackbarth.com"
        aria-label="Send Email"
        title="Email"
        class="contact-link"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span class="contact-label">Email</span>
      </a>
      
      <a
        href="https://github.com/jonathon-hackbarth"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        title="GitHub"
        class="contact-link"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        <span class="contact-label">GitHub</span>
      </a>
      
      <a
        href="https://linkedin.com/in/jonathon-w-hackbarth"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        title="LinkedIn"
        class="contact-link"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="contact-label">LinkedIn</span>
      </a>
      
      <a
        href="#resume"
        aria-label="View Resume"
        title="Resume"
        class="contact-link"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        <span class="contact-label">Resume</span>
      </a>
    </div>
  </div>
  
  <!-- Impact Metrics Grid -->
  <div class="w-full max-w-6xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 animate-fade-up">
      {metrics.map((metric, index) => (
        <button 
          class="metric-card cursor-pointer" 
          style={`animation-delay: ${(index + 1) * 0.1}s; min-height: 200px;`}
          data-target={metric.target}
          type="button"
          aria-label={`${metric.value} - ${metric.label}, click to view details`}
        >
          <div class="flex flex-col items-center gap-4 w-full">
            <div class="metric-value">{metric.value}</div>
            <div class="metric-label">{metric.label}</div>
            <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-[var(--bg-elevated)] text-[var(--accent-hero)] border border-[var(--border-card)]">
              {metric.icon === 'chart' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-icon"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
              )}
              {metric.icon === 'sparkles' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-icon"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4L18.4 5.6"/></svg>
              )}
              {metric.icon === 'rocket' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-icon"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
              )}
              {metric.icon === 'lightning' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="metric-icon"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              )}
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const metricIdMapping: Record<string, string> = {
    "metric-m365-copilot": "job-1-highlight-0",
    "metric-github-copilot": "job-0-highlight-0",
    "metric-azure-architect": "job-0-highlight-6",
    "metric-power-platform": "job-2-highlight-0",
  };

  document.querySelectorAll('.metric-card[data-target]').forEach(card => {
    card.addEventListener('click', () => {
      const targetId = card.getAttribute('data-target');
      if (!targetId) return;

      const actualId = metricIdMapping[targetId] || targetId;
      const target = document.getElementById(actualId);
      if (!target) return;

      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      setTimeout(() => {
        target.classList.add('active');
      }, 500);
    });
  });

  const highlightElements = document.querySelectorAll('.metric-highlight');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!(entry.target instanceof HTMLElement)) return;
      if (entry.isIntersecting && entry.target.classList.contains('active')) {
        entry.target.style.fontWeight = '600';
      } else {
        entry.target.classList.remove('active');
        entry.target.style.fontWeight = '';
      }
    });
  }, { threshold: 0.5 });

  highlightElements.forEach(el => observer.observe(el));
</script>

<style>
  .metric-icon {
    width: 24px;
    height: 24px;
  }
</style>
